# Note: Run `docker build -t php-nodejs:8.3 -f docker/Dockerfile.php-nodejs-8.3 .` to build the image locally
# Note: Run `docker build -t mburton3969/php-nodejs:8.3 -f docker/Dockerfile.php-nodejs-8.3 .` to build the image for production environment

# Multi-stage build for PHP-NodeJS base image
FROM php:8.3-apache AS builder

ARG PHPIZE_DEPS="libpng-dev libjpeg-dev libfreetype6-dev libzip-dev libssl-dev libicu-dev curl gnupg"
ARG PHP_EXTS="pdo pdo_mysql mysqli zip ftp gd bcmath pcntl sockets intl opcache"
ARG PHP_PECL_EXTS=""
ARG NODE_VERSION=20

ENV PNPM_HOME=/usr/local/share/pnpm
ENV PATH="${PATH}:${PNPM_HOME}"

# 1. SYSTEM DEPENDENCIES: PHP extensions + Node.js in a single cached layer
RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    set -eux; \
    apt-get update && apt-get install -y --no-install-recommends \
        ${PHPIZE_DEPS}; \
    # PHP extensions
    docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg; \
    docker-php-ext-configure intl; \
    docker-php-ext-configure ftp --with-openssl-dir=/usr; \
    docker-php-ext-install -j$(nproc) ${PHP_EXTS}; \
    # PECL extensions — only if requested
    if [ -n "${PHP_PECL_EXTS}" ]; then \
        pecl channel-update pecl.php.net; \
        pecl install ${PHP_PECL_EXTS}; \
        docker-php-ext-enable ${PHP_PECL_EXTS}; \
    fi; \
    # Node.js
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg; \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_VERSION}.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list; \
    apt-get update && apt-get install -y --no-install-recommends nodejs; \
    corepack enable; \
    corepack prepare pnpm@latest --activate; \
    rm -rf /tmp/* /var/tmp/* /root/.npm

# 2. PRODUCTION IMAGE: Minimal runtime — no Node/pnpm (build assets in a separate node stage in app Dockerfiles)
FROM php:8.3-apache AS production

ENV APACHE_DOCUMENT_ROOT=/var/www/html/public \
    COMPOSER_ALLOW_SUPERUSER=1

# PHP extensions from builder (compiled .so files + their ini stubs)
COPY --from=builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/
COPY --from=builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/

# Apache: modules + vhost + performance defaults — configured here on a clean base
RUN a2enmod rewrite headers expires deflate; \
    echo 'export APACHE_DOCUMENT_ROOT="${APACHE_DOCUMENT_ROOT:-/var/www/html/public}"' \
        >> /etc/apache2/envvars; \
    printf '<VirtualHost *:80>\n\
    DocumentRoot ${APACHE_DOCUMENT_ROOT}\n\
    <Directory ${APACHE_DOCUMENT_ROOT}>\n\
        Options -Indexes +FollowSymLinks\n\
        AllowOverride All\n\
        Require all granted\n\
    </Directory>\n\
    ErrorLog ${APACHE_LOG_DIR}/error.log\n\
    CustomLog ${APACHE_LOG_DIR}/access.log combined\n\
</VirtualHost>\n' > /etc/apache2/sites-available/000-default.conf; \
    printf 'ServerTokens Prod\n\
ServerSignature Off\n\
TraceEnable Off\n\
<IfModule mod_deflate.c>\n\
    AddOutputFilterByType DEFLATE text/html text/plain text/css\n\
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/json\n\
    AddOutputFilterByType DEFLATE image/svg+xml\n\
</IfModule>\n\
<IfModule mod_expires.c>\n\
    ExpiresActive On\n\
    ExpiresByType image/jpeg "access plus 1 year"\n\
    ExpiresByType image/png "access plus 1 year"\n\
    ExpiresByType image/webp "access plus 1 year"\n\
    ExpiresByType image/svg+xml "access plus 1 year"\n\
    ExpiresByType text/css "access plus 1 month"\n\
    ExpiresByType application/javascript "access plus 1 month"\n\
    ExpiresByType font/woff2 "access plus 1 year"\n\
</IfModule>\n\
<IfModule mod_headers.c>\n\
    Header always set X-Content-Type-Options "nosniff"\n\
    Header always set X-Frame-Options "SAMEORIGIN"\n\
    Header unset X-Powered-By\n\
</IfModule>\n' > /etc/apache2/conf-available/performance.conf; \
    a2enconf performance

# Runtime library dependencies only (no build tools, no Node)
RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    set -eux; \
    apt-get update && apt-get install -y --no-install-recommends \
        libpng16-16t64 \
        libjpeg62-turbo \
        libfreetype6 \
        libzip5 \
        libicu76 \
        libssl3t64 \
        supervisor \
        unzip \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*; \
    # Remap www-data uid/gid to 1000 for host-volume compatibility
    usermod -u 1000 www-data && groupmod -g 1000 www-data; \
    chown -R www-data:www-data /var/www /var/log/apache2 /var/run/apache2

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# PHP performance defaults — override by adding zz-app.ini in /usr/local/etc/php/conf.d/
RUN { \
        echo 'upload_max_filesize = 100M'; \
        echo 'post_max_size = 100M'; \
        echo 'max_execution_time = 300'; \
        echo 'memory_limit = 256M'; \
        echo 'realpath_cache_ttl = 600'; \
    } > /usr/local/etc/php/conf.d/performance.ini; \
    { \
        echo 'opcache.enable=1'; \
        echo 'opcache.memory_consumption=256'; \
        echo 'opcache.interned_strings_buffer=64'; \
        echo 'opcache.max_accelerated_files=20000'; \
        echo 'opcache.revalidate_freq=2'; \
        echo 'opcache.enable_cli=1'; \
        echo 'opcache.jit=tracing'; \
        echo 'opcache.jit_buffer_size=64M'; \
    } > /usr/local/etc/php/conf.d/opcache.ini

WORKDIR /var/www/html/
