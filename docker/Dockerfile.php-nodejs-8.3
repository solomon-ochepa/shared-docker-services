# Note: Run `docker build -t php-nodejs:8.3 -f docker/Dockerfile.php-nodejs-8.3 .` to build the image locally
# Note: Run `docker build -t mburton3969/php-nodejs:8.3 -f docker/Dockerfile.php-nodejs-8.3 .` to build the image for production environment

# Multi-stage build for PHP-NodeJS base image
FROM php:8.3-apache AS builder

# Define the build arguments with default values
ARG PHPIZE_DEPS="libpng-dev libjpeg-dev libfreetype6-dev libzip-dev libssl-dev libicu-dev ca-certificates curl gnupg supervisor"
ARG PHP_EXTS="pdo pdo_mysql mysqli zip ftp gd pcntl sockets intl opcache"
ARG PHP_PECL_EXTS=""
ARG NODE_VERSION=20

# Set Environment Variables
ENV APACHE_DOCUMENT_ROOT=/var/www/html/public
ENV COMPOSER_ALLOW_SUPERUSER=1
ENV PNPM_HOME=/usr/local/share/pnpm
ENV PATH="${PATH}:${PNPM_HOME}"

# 1. SYSTEM DEPENDENCIES: Single layer for all system packages
RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    set -eux; \
    # Update and install dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        ${PHPIZE_DEPS} \
        && rm -rf /var/lib/apt/lists/*; \
    # PHP extensions - configure and install
    docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg; \
    docker-php-ext-configure intl; \
    docker-php-ext-configure ftp --with-openssl-dir=/usr; \
    docker-php-ext-install -j$(nproc) ${PHP_EXTS}; \
    # PECL extensions - only install if specified
    if [ -n "${PHP_PECL_EXTS}" ]; then \
        pecl channel-update pecl.php.net; \
        pecl install ${PHP_PECL_EXTS}; \
        docker-php-ext-enable ${PHP_PECL_EXTS}; \
    fi; \
    # Node.js installation (optimized)
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg; \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_VERSION}.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list; \
    apt-get update && apt-get install -y nodejs \
        && rm -rf /var/lib/apt/lists/*; \
    # pnpm installation (more efficient than npm)
    corepack enable; \
    corepack prepare pnpm@latest --activate; \
    # Apache configuration
    a2enmod rewrite headers expires deflate; \
    sed -ri \
        -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' \
        -e 's!AllowOverride None!AllowOverride All!g' \
        /etc/apache2/apache2.conf; \
    echo "<Directory ${APACHE_DOCUMENT_ROOT}>\n\
        Options -Indexes +FollowSymLinks\n\
        AllowOverride All\n\
        Require all granted\n\
    </Directory>" > /etc/apache2/conf-available/document-root.conf; \
    a2enconf document-root; \
    # Cleanup
    apt-get clean && rm -rf /tmp/* /var/tmp/* /root/.npm

# 2. PRODUCTION IMAGE: Minimal runtime image
FROM php:8.3-apache AS production

ENV APACHE_DOCUMENT_ROOT=/var/www/html/public \
    PNPM_HOME=/usr/local/share/pnpm \
    PATH="${PATH}:${PNPM_HOME}" \
    COMPOSER_ALLOW_SUPERUSER=1

# Copy only runtime files from builder
COPY --from=builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/
COPY --from=builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=builder /usr/local/bin/ /usr/local/bin/
COPY --from=builder /usr/bin/node /usr/bin/node
COPY --from=builder /usr/bin/npm /usr/bin/npm
COPY --from=builder /usr/bin/corepack /usr/bin/corepack
COPY --from=builder /usr/lib/node_modules/corepack /usr/lib/node_modules/corepack
COPY --from=builder /root/.cache/node/corepack /root/.cache/node/corepack
RUN ln -sf /usr/lib/node_modules/corepack/dist/pnpm.js /usr/bin/pnpm
COPY --from=builder /etc/apache2/ /etc/apache2/

# Install minimal runtime dependencies
RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    set -eux; \
    apt-get update && apt-get install -y --no-install-recommends \
        libpng16-16t64 \
        libjpeg62-turbo \
        libfreetype6 \
        libzip5 \
        libicu76 \
        libssl3t64 \
        ca-certificates \
        curl \
        supervisor \
        git \
        unzip \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*; \
    # Create www-data user with proper UID if not exists
    id -u www-data &>/dev/null || useradd -u 1000 -m -s /bin/bash www-data; \
    usermod -u 1000 www-data && groupmod -g 1000 www-data; \
    # Set proper permissions
    mkdir -p /var/www/html; \
    chown -R www-data:www-data /var/www; \
    chmod 755 /var/www/html

# Install Composer from official image
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Default PHP configuration (optimized for performance)
RUN { \
        echo 'upload_max_filesize = 100M'; \
        echo 'post_max_size = 100M'; \
        echo 'max_execution_time = 300'; \
        echo 'memory_limit = 256M'; \
    } > /usr/local/etc/php/conf.d/uploads.ini && \
    { \
        echo 'opcache.enable=1'; \
        echo 'opcache.memory_consumption=256'; \
        echo 'opcache.interned_strings_buffer=32'; \
        echo 'opcache.max_accelerated_files=20000'; \
        echo 'opcache.revalidate_freq=2'; \
        echo 'opcache.fast_shutdown=1'; \
        echo 'opcache.enable_cli=1'; \
    } > /usr/local/etc/php/conf.d/opcache.ini

WORKDIR /var/www/html/
